# Copy to `.env` (gitignored) and fill in your values, then run: make generate
#
#   cp .env.example .env

# Apple Developer Team ID (Xcode → Settings → Accounts → Team ID)
DEVELOPMENT_TEAM=YOUR_TEAM_ID_HERE

# Google Sign-In — OAuth client ID (iOS) from Google Cloud Console
GID_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com

# Google Sign-In URL scheme — optional; derived from GID_CLIENT_ID when empty
# Format: com.googleusercontent.apps.<client-id-prefix>
GOOGLE_URL_SCHEME=com.googleusercontent.apps.YOUR_CLIENT_ID_PREFIX

# KLIPY GIF picker — https://partner.klipy.com/
KLIPY_API_KEY=YOUR_KLIPY_API_KEY_HERE
